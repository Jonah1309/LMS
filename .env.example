# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite (default for dev):
DATABASE_URL=sqlite:///./lms.db
# PostgreSQL (uncomment when ready):
# DATABASE_URL=postgresql://lms:lms@db:5432/lms

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

S3_RAW_BUCKET=grace-academy-raw-uploads
S3_DELIVERY_BUCKET=grace-academy-hls-delivery

CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

MEDIACONVERT_ENDPOINT=
MEDIACONVERT_ROLE_ARN=

SES_FROM_EMAIL=no-reply@graceacademy.com

# ── Payments ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
